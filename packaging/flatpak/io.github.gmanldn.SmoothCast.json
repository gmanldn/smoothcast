{
  "id": "io.github.gmanldn.SmoothCast",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "smoothcast",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=home:ro"
  ],
  "modules": [
    "python3-deps.json",
    {
      "name": "x264",
      "buildsystem": "autotools",
      "config-opts": [
        "--enable-shared",
        "--enable-pic",
        "--disable-cli"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://code.videolan.org/videolan/x264.git",
          "commit": "b35605ace3ddf7c1a5d67a2eb553f034aef41d55"
        }
      ]
    },
    {
      "name": "ffmpeg",
      "buildsystem": "autotools",
      "config-opts": [
        "--enable-gpl",
        "--enable-libx264",
        "--enable-vaapi",
        "--enable-ffplay",
        "--enable-shared",
        "--disable-static",
        "--disable-doc",
        "--disable-debug"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/ffmpeg/examples"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://git.ffmpeg.org/ffmpeg.git",
          "tag": "n8.1.3",
          "commit": "1041abdc962f4cc4f394aa8de9dc5236c0c3b9e7"
        }
      ]
    },
    {
      "name": "smoothcast",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --verbose --no-index --no-deps --no-build-isolation --prefix=${FLATPAK_DEST} .",
        "install -Dm644 packaging/flatpak/io.github.gmanldn.SmoothCast.desktop /app/share/applications/io.github.gmanldn.SmoothCast.desktop",
        "install -Dm644 data/cast-control.png /app/share/icons/hicolor/128x128/apps/io.github.gmanldn.SmoothCast.png",
        "python3 -c 'import cli, catt, pychromecast, zeroconf, psutil, segno, gi; gi.require_version(\"Gtk\", \"4.0\"); gi.require_version(\"Adw\", \"1\"); from gi.repository import Gtk, Adw'",
        "command -v ffmpeg >/dev/null && command -v ffprobe >/dev/null && command -v ffplay >/dev/null",
        "ffmpeg -hide_banner -encoders | grep -q libx264 && ffmpeg -hide_banner -encoders | grep -q h264_vaapi"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
