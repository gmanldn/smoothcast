{
  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "key": {
            "pattern": "^qh:[0-9a-f]{32}$",
            "type": "string"
          },
          "queue_command_id": {
            "type": "string"
          },
          "queue_revision": {
            "type": "integer"
          },
          "value": {}
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "type": "string"
          },
          "ok": {
            "const": false
          }
        },
        "type": "object"
      },
      "Login": {
        "properties": {
          "name": {
            "maxLength": 40,
            "type": "string"
          },
          "pin": {
            "pattern": "^[0-9]{6}$",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Profile": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "UploadStart": {
        "properties": {
          "name": {
            "type": "string"
          },
          "queue": {
            "type": "boolean"
          },
          "size": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "size"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "csrf": {
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      },
      "session": {
        "in": "cookie",
        "name": "sc_portal_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "HTTP/SSE API of a SmoothCast node on the trusted home LAN. Sessions are cookie-based; mutations also need the CSRF token returned by /api/login in X-CSRF-Token.",
    "title": "SmoothCast room API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
