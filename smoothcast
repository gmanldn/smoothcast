#!/usr/bin/env bash
# SmoothCast portable launcher. Python 3.10+ is the only manual prerequisite.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="${PYTHON:-python3}"

# GUI testing is never permitted through the ordinary launcher: it could
# bootstrap dependencies or show a window on the developer's active desktop.
# The isolated Xvfb runner invokes src/cast_control.py directly instead.
for arg in "$@"; do
    if [[ "$arg" == "--self-test" ]]; then
        echo "Refusing direct GUI self-test. Run: python3 scripts/test_gui_isolated.py" >&2
        exit 2
    fi
done

# Version and diagnostics queries never install anything or import GTK.
if [[ $# -eq 1 && ( "$1" == "--version" || "$1" == "-V" ) ]]; then
    exec "$PYTHON" "$DIR/src/version.py"
fi

if [[ "${1:-}" == "--diagnostics" ]]; then
    exec "$PYTHON" "$DIR/src/diagnostics.py" "${@:2}"
fi

if [[ "${SMOOTHCAST_TEST_CONTEXT:-}" == "1" ]]; then
    echo "Refusing to start SmoothCast GUI from pytest." >&2
    exit 2
fi

if ! "$PYTHON" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
    echo "SmoothCast needs Python 3.10+; run the platform setup script first." >&2
    exit 1
fi

case "$(uname -s)" in
    Linux) TARGET=linux ;;
    Darwin) TARGET=macos ;;
    *) echo "On Windows run setup/winsetup.bat and then python sc.py." >&2; exit 1 ;;
esac

RUNTIME="$DIR/.venv/bin/python"
NEEDS_SETUP=0
if [[ ! -f "$RUNTIME" ]] || ! "$RUNTIME" -c 'import gi,importlib.metadata as m,re,sys;gi.require_version("Gtk","4.0");gi.require_version("Adw","1");from gi.repository import Gtk,Adw;v=m.version("catt");match=re.fullmatch(r"(\d+)\.(\d+)(?:\.\d+)?(?:\.post\d+)?(?:\+[A-Za-z0-9.]+)?",v);sys.exit(0 if match and (int(match[1]),int(match[2]))>=(0,12) else 1)' >/dev/null 2>&1; then
    NEEDS_SETUP=1
fi
for tool in ffmpeg ffprobe ffplay; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        NEEDS_SETUP=1
        break
    fi
done
if [[ "$NEEDS_SETUP" -eq 1 ]]; then
    "$PYTHON" "$DIR/setup/bootstrap.py" --target "$TARGET"
fi

if [[ "$TARGET" == linux && -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" && " $* " != *" --self-test "* ]]; then
    "$PYTHON" "$DIR/scripts/install_desktop.py" --quiet || true
fi

exec "$PYTHON" "$DIR/setup/launch.py" "$@"
