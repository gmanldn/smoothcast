#!/usr/bin/env bash
# SmoothCast — cross-platform bootstrap launcher.
# First run creates project .venv via setup/bootstrap.py, then delegates to setup/launch.py.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME="$DIR/.venv/bin/python"
TARGET="$DIR/.venv"

# Handle version requests without bootstrapping.
if [[ "$1" == "--version" || "$1" == "-V" ]]; then
    exec "$PYTHON" "$DIR/src/version.py"
fi

# Ensure bootstrap has run and created the runtime.
if [[ ! -x "$RUNTIME" ]]; then
    echo "SmoothCast: bootstrapping runtime..."
    "$DIR/setup/bootstrap.py" --target "$TARGET" || {
        echo "SmoothCast: bootstrap failed" >&2
        exit 1
    }
fi

# Validate catt version in the runtime.
# Avoid importing catt at startup; use importlib.metadata.
"$RUNTIME" -c '
import re, sys
import importlib.metadata as m
try:
    if tuple(map(int, re.findall(r"\d+",m.version("catt"))[:2])) < (0, 12):
        sys.exit("catt >= 0.12 required")
except Exception:
    sys.exit("catt not found in runtime")
' || {
    echo "SmoothCast: catt >= 0.12 not found in runtime, re-running bootstrap..."
    "$DIR/setup/bootstrap.py" --target "$TARGET" || {
        echo "SmoothCast: bootstrap failed" >&2
        exit 1
    }
}

# Check for required system tools.
for tool in ffmpeg ffprobe ffplay; do
    command -v "$tool" >/dev/null || {
        echo "SmoothCast: required tool '$tool' not found in PATH" >&2
        exit 1
    }
done

# Delegate to the portable launcher.
exec "$DIR/setup/launch.py" "$@"
EOF
chmod +x smoothcast
cat smoothcast | head -25