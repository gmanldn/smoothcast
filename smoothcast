#!/usr/bin/env bash
# SmoothCast portable launcher: Python 3.10+ is the sole manual prerequisite.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
PYTHON="${PYTHON:-python3}"

if ! "$PYTHON" -c 'import sys;sys.exit(sys.version_info < (3,10))' 2>/dev/null; then
    echo "SmoothCast requires Python 3.10+; please install it first." >&2
    exit 1
fi

# Version lookup is always side-effect free and never requires GTK or a venv.
if [[ $# -eq 1 && ( "$1" == "--version" || "$1" == "-V" ) ]]; then
    exec "$PYTHON" "$DIR/src/version.py"
fi

# A previous interrupted installation can leave a venv executable behind
# without working GTK/catt dependencies. Detect that instead of silently
# failing when the application is launched from a graphical dock.
case "$(uname -s)" in
    Darwin) TARGET=macos ;;
    Linux) TARGET=linux ;;
    *) echo "Use setup/winsetup.bat on Windows." >&2; exit 1 ;;
esac
RUNTIME="$DIR/.venv/bin/python"
if [[ ! -f "$RUNTIME" ]] || ! "$RUNTIME" -c 'import gi,importlib.metadata as m;gi.require_version("Gtk","4.0");gi.require_version("Adw","1");from gi.repository import Gtk,Adw;m.version("catt")' >/dev/null 2>&1; then
    "$PYTHON" "$DIR/setup/bootstrap.py" --target "$TARGET"
fi

# Keep Linux GNOME dock integration self-healing, with no sudo.
if [[ "$(uname -s)" == "Linux" && -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" && " $* " != *" --self-test "* ]]; then
    "$PYTHON" "$DIR/scripts/install_desktop.py" --quiet || true
fi
exec "$PYTHON" "$DIR/setup/launch.py" "$@"
